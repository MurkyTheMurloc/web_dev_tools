{
    // Solid rules run through a local Oxlint JS plugin.
    // The plugin provides a local Solid rule port plus project-specific rules.
    "rules": {
        "solid/components-return-once": "error",
        "solid/event-handlers": "error",
        "solid/imports": "error",
        "solid/jsx-no-duplicate-props": "error",
        "solid/jsx-no-script-url": "error",
        "solid/jsx-no-undef": "error",
        "solid/jsx-uses-vars": "error",
        "solid/no-array-handlers": "error",
        "solid/no-cleanup-in-effect-apply": "error",
        "solid/no-destructure": "error",
        "solid/no-innerhtml": "error",
        "solid/no-module-scope-reactive-primitive": "error",
        "solid/no-owned-primitives-in-ref": "error",
        // Only for targets without Proxy; createStore and createProjection are
        // the core Solid 2.0 store API.
        "solid/no-proxy-apis": "off",
        "solid/no-react-deps": "error",
        "solid/no-react-specific-props": "error",
        "solid/no-setter-in-effect": "error",
        "solid/no-server-import-in-client": "error",
        "solid/no-single-arg-create-effect": "error",
        "solid/no-unknown-namespaces": "error",
        "solid/no-write-in-pure-computation": "error",
        "solid/no-untracked-effect-read": "error",
        "solid/prefer-arrow-components": "error",
        "solid/prefer-class-object": "error",
        "solid/prefer-destructuring": "error",
        "solid/prefer-for": "error",
        "solid/prefer-ref-shorthand": "error",
        "solid/prefer-show": "error",
        "solid/reactive-async": "error",
        "solid/reactivity": "error",
        "solid/self-closing-comp": "error",
        "solid/strict-void-return": "error",
        "solid/style-prop": "error",
        "solid/typed-merge-defaults": "error",
        "solid/validate-jsx-nesting": "error"
    },
    "overrides": [
        {
            "files": ["**/*.jsx", "**/*.tsx"],
            "rules": {
                // Solid components intentionally use Component<Props> /
                // ParentComponent<Props> arrow signatures. The generic
                // prefer-readonly-parameter-types rule conflicts with that
                // convention and would reject the autofix immediately.
                "typescript/prefer-readonly-parameter-types": "off",
                // Solid reads a promise returned from a reactive computation
                // like a value, so `createMemo(() => load(id()))` needs no
                // `async`. `solid/reactive-async` covers the async cases
                // (reads after an await, `return await`).
                "typescript/promise-function-async": "off",
                // The typed rule needs types for what handlers return; the
                // syntax-only `solid/strict-void-return` covers handlers,
                // `ref` and `onCleanup`/`onSettled` callbacks.
                "typescript/strict-void-return": "off",
                // Solid's docs write derived values as un-annotated accessors,
                // `const total = () => props.price * props.qty`, and type
                // components through `Component<P>`, which the rule already
                // accepts. Exports stay covered by explicit-module-boundary-types.
                "typescript/explicit-function-return-type": "off",
                // Solid evaluates a ternary in an attribute or a child reactively,
                // and the compiler memoizes element branches (a prod <Show>
                // compiles to the same ternary). The replacement, `let` + `if`
                // in the component body, runs once and is not reactive.
                // no-nested-ternary and no-unneeded-ternary stay on everywhere.
                "eslint/no-ternary": "off",
                // A `let` that a `ref` assigns has no value to start with:
                // Solid sets it to the element (`let el!: HTMLDivElement;`
                // with `ref={el}`, `let el: Optional<HTMLDivElement>;` under
                // `<Show>`), and a default would be a value nobody reads.
                // solid/init-declarations is eslint's rule with that one
                // exception; it is on only here, so `.ts` files keep
                // eslint/init-declarations alone.
                "eslint/init-declarations": "off",
                "solid/init-declarations": "error",
                // `ref={el}` assigns `el`: Solid's compiler rewrites the single
                // shorthand to `el = node`, which eslint's scope analysis sees
                // as a read only. solid/no-unassigned-vars is eslint's rule
                // with that exception; `.ts` files keep
                // eslint/no-unassigned-vars from eslint.jsonc.
                "eslint/no-unassigned-vars": "off",
                "solid/no-unassigned-vars": "error",
                // A file that exports a component is PascalCase and named
                // after it (`Navigate.tsx`), a file that only uses JSX stays
                // snake_case (`solid_ssr_renderer.tsx`). filename-case allows
                // both here; solid/filename-matches-export decides which one
                // applies. `.ts` files keep snakeCase alone from unicorn.jsonc.
                "unicorn/filename-case": [
                    "error",
                    { "cases": { "snakeCase": true, "pascalCase": true } }
                ],
                // Skips **/pages/** and **/routes/**, which follow the
                // router's naming.
                "solid/filename-matches-export": "error"
            }
        }
    ]
}
