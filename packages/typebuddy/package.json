{
  "name": "@murky-web/typebuddy",
  "version": "2.0.0",
  "description": "Your new best friend for simple typescript guards every project needs.",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./guards": {
      "types": "./src/guards.ts",
      "import": "./dist/guards.js",
      "default": "./dist/guards.js"
    },
    "./result": {
      "types": "./src/result.ts",
      "import": "./dist/result.js",
      "default": "./dist/result.js"
    },
    "./parse": {
      "types": "./src/parse.ts",
      "import": "./dist/parse.js",
      "default": "./dist/parse.js"
    },
    "./empty": {
      "types": "./src/empty.ts",
      "import": "./dist/empty.js",
      "default": "./dist/empty.js"
    },
    "./ids": {
      "types": "./src/ids.ts",
      "import": "./dist/ids.js",
      "default": "./dist/ids.js"
    },
    "./collections": {
      "types": "./src/collections.ts",
      "import": "./dist/collections.js",
      "default": "./dist/collections.js"
    },
    "./globals": {
      "types": "./globals.d.ts"
    },
    "./oxlint": {
      "types": "./oxlint/index.ts",
      "import": "./dist/oxlint.js",
      "default": "./dist/oxlint.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "build:local": "bun run build",
    "build": "bun run clean && tsdown",
    "clean": "rm -rf dist",
    "lint": "oxlint -c ./.oxlintrc.jsonc --tsconfig ./tsconfig.lint.json --type-aware src tsdown.config.ts vitest.config.ts",
    "lint:fix": "oxlint -c ./.oxlintrc.jsonc --tsconfig ./tsconfig.lint.json --type-aware --fix src tsdown.config.ts vitest.config.ts",
    "format": "oxfmt -c ../../config/oxc/.oxfmtrc.jsonc src rules tests tsdown.config.ts vitest.config.ts",
    "format:check": "oxfmt -c ../../config/oxc/.oxfmtrc.jsonc --check src rules tests tsdown.config.ts vitest.config.ts",
    "smoke:globals": "bun run build && tsc --project ./smoke/globals/tsconfig.json --noEmit && mkdir -p ./smoke/globals/node_modules/@murky-web && ln -sfn ../../../.. ./smoke/globals/node_modules/@murky-web/typebuddy && tsc --project ./smoke/globals/tsconfig.types.json --noEmit",
    "smoke:oxlint": "bun run build && bun ./smoke/oxlint/run-smoke.ts",
    "smoke:oxlint:fix": "bun run build && bun ./smoke/oxlint/run-fix-smoke.ts",
    "smoke:subpath": "bun run build && bun ./smoke/subpath/run.ts",
    "smoke:treeshake": "bun run build && bun ./smoke/treeshake/run.ts",
    "typecheck": "tsc --project ./tsconfig.json --noEmit && tsc --project ./tsconfig.vitest.json --noEmit"
  },
  "files": [
    "dist",
    "globals.d.ts",
    "jsr.json",
    "oxlint/index.ts",
    "rules",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MurkyTheMurloc/web_dev_tools.git",
    "directory": "packages/typebuddy"
  },
  "homepage": "https://github.com/MurkyTheMurloc/web_dev_tools/tree/main/packages/typebuddy",
  "bugs": {
    "url": "https://github.com/MurkyTheMurloc/web_dev_tools/issues"
  },
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}
